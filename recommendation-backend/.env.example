ENVIRONMENT=production
DEBUG=false
FIREBASE_PROJECT_ID=sielo-music
FIREBASE_CREDENTIALS_PATH=/etc/secrets/firebase_service_account.json
ADMIN_API_KEY=your_secure_random_admin_api_key_here
RETRAIN_INTERVAL_HOURS=24
MIN_NEW_EVENTS_TO_RETRAIN=50
HALF_LIFE_DAYS=21.0
ALLOW_MOCK_AUTH_FOR_TESTS=false

# Trending System API Keys & Configuration (Set in Render Dashboard)
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here
LASTFM_API_KEY=your_lastfm_api_key_here
DEFAULT_TRENDING_MARKET=IN
TRENDING_CACHE_TTL_MINUTES=60
TRENDING_REFRESH_INTERVAL_HOURS=3

